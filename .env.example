# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Whoop OAuth2 ---
# Client ID is not a secret (it ships in the app). Client Secret IS a secret.
WHOOP_CLIENT_ID=999f682c-beaf-4aad-91e4-5371c487d1ce
WHOOP_REDIRECT_URI=http://localhost:8080/callback
# You add this locally. It is used ONLY for the token exchange. In production
# the token exchange should run on your own backend so the secret never ships
# in the app bundle. For local V1 dev it is read by the token exchange helper.
WHOOP_CLIENT_SECRET=

# --- Claude Vision (food photo estimation) ---
# WARNING: putting an API key in a mobile app exposes it. Use only a restricted
# key for local testing, or (recommended) route the vision call through your
# own backend proxy and leave this blank. See README "Security".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
