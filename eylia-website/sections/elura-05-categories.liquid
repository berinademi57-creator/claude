{% comment %} ELURA · Section 05 – Nach Kategorie shoppen (klare Navigation → mehr Conversion) {% endcomment %}
<style>
  .el-cat{--ink:#211d1a;--muted:#7a7168;--gold:#b08d57;--line:#e5dccf;background:#fff;
    padding:88px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
  .el-cat .wrap{max-width:1240px;margin:0 auto;padding:0 24px}
  .el-cat .head{text-align:center;margin:0 auto 52px}
  .el-cat .eyebrow{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:600}
  .el-cat h2{font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(34px,4.4vw,52px);font-weight:600;margin:12px 0 0;color:var(--ink)}
  .el-cat .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  .el-cat .tile{position:relative;aspect-ratio:3/4;border-radius:5px;overflow:hidden;display:block}
  .el-cat .tile img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
  .el-cat .tile:hover img{transform:scale(1.06)}
  .el-cat .tile::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(25,20,15,.62),rgba(25,20,15,0) 55%)}
  .el-cat .label{position:absolute;left:0;right:0;bottom:26px;text-align:center;z-index:2;color:#fff}
  .el-cat .label h3{font-family:"Cormorant Garamond",Georgia,serif;font-size:28px;font-weight:600;margin:0}
  .el-cat .label span{font-size:12px;letter-spacing:.16em;text-transform:uppercase;opacity:.9}
  @media(max-width:800px){ .el-cat .grid{grid-template-columns:1fr} }
</style>
<section class="el-cat">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="grid">
      {% for block in section.blocks %}
        {% assign c = block.settings.collection %}
        <a class="tile" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% elsif c != blank %}{{ c.url }}{% else %}#{% endif %}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.title | escape }}">
          {% elsif block.settings.img_url != blank %}
            <img src="{{ block.settings.img_url }}" alt="{{ block.settings.title | escape }}">
          {% elsif c != blank and c.products.first != blank %}
            <img src="{{ c.products.first.featured_image | image_url: width: 700 }}" alt="{{ block.settings.title | escape }}">
          {% else %}
            <img src="https://cdn.shopify.com/s/files/1/1035/8548/1052/files/2DFE4632-1775-4461-B522-C17E692919D9.jpg?v=1783120759" alt="{{ block.settings.title | escape }}">
          {% endif %}
          <div class="label">
            <h3>{% if block.settings.title != blank %}{{ block.settings.title }}{% elsif c != blank %}{{ c.title }}{% endif %}</h3>
            <span>{{ block.settings.subtitle }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ELURA · Kategorien",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleiner Text", "default": "Finde deinen Stil" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Nach Kategorie shoppen" }
  ],
  "blocks": [
    { "type": "cat", "name": "Kategorie", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection (Bild & Link automatisch)" },
      { "type": "text", "id": "title", "label": "Titel (optional)" },
      { "type": "text", "id": "subtitle", "label": "Unterzeile", "default": "Flower · Kleeblatt · Kaia" },
      { "type": "image_picker", "id": "image", "label": "Eigenes Bild (optional)" },
      { "type": "text", "id": "img_url", "label": "Bild-URL (optional, falls kein Bild gewählt)" },
      { "type": "url", "id": "link", "label": "Eigener Link (optional)" }
    ]}
  ],
  "presets": [ { "name": "ELURA · Kategorien", "blocks": [
    { "type": "cat", "settings": { "title": "Armbänder", "subtitle": "Flower · Kleeblatt · Kaia", "link": "/collections/armbander-1", "img_url": "https://cdn.shopify.com/s/files/1/1035/8548/1052/files/2DFE4632-1775-4461-B522-C17E692919D9.jpg?v=1783120759" } },
    { "type": "cat", "settings": { "title": "Halsketten", "subtitle": "Flower · Isleen · Kleeblatt", "link": "/collections/halsketten", "img_url": "https://cdn.shopify.com/s/files/1/1035/8548/1052/files/9EC4A7FD-6E76-48CA-AE8B-938B13251007.jpg?v=1783120756" } },
    { "type": "cat", "settings": { "title": "Ringe", "subtitle": "Flower · Amélia · Koh Samui", "link": "/collections/ringe", "img_url": "https://cdn.shopify.com/s/files/1/1035/8548/1052/files/758BBBC3-7E46-43C4-B438-6B3DD1CAB323.jpg?v=1783121012" } }
  ]}]
}
{% endschema %}
