{% comment %} ELURA · Section 10 – FAQ (beantwortet Kauf-Einwände direkt → mehr Conversion) {% endcomment %}
<style>
  .el-faq{--ink:#211d1a;--muted:#7a7168;--gold:#b08d57;--line:#e5dccf;padding:88px 0;background:#faf6f1;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
  .el-faq .wrap{max-width:760px;margin:0 auto;padding:0 24px}
  .el-faq .head{text-align:center;margin:0 auto 40px}
  .el-faq .eyebrow{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:600}
  .el-faq h2{font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(32px,4vw,48px);font-weight:600;margin:12px 0 0;color:var(--ink)}
  .el-faq details{border-bottom:1px solid var(--line);padding:6px 0}
  .el-faq summary{list-style:none;cursor:pointer;padding:18px 0;font-size:16.5px;font-weight:600;color:var(--ink);
    display:flex;justify-content:space-between;align-items:center;gap:16px}
  .el-faq summary::-webkit-details-marker{display:none}
  .el-faq summary::after{content:"+";font-size:24px;color:var(--gold);font-weight:400;transition:transform .2s}
  .el-faq details[open] summary::after{transform:rotate(45deg)}
  .el-faq .ans{color:var(--muted);font-size:15px;line-height:1.7;padding:0 0 20px}
</style>
<section class="el-faq">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {% for block in section.blocks %}
      <details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
        <summary>{{ block.settings.q }}</summary>
        <div class="ans">{{ block.settings.a }}</div>
      </details>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "ELURA · FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleiner Text", "default": "Noch Fragen?" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Häufige Fragen" }
  ],
  "blocks": [
    { "type": "faq", "name": "Frage", "settings": [
      { "type": "text", "id": "q", "label": "Frage", "default": "Läuft der Schmuck an?" },
      { "type": "textarea", "id": "a", "label": "Antwort", "default": "Nein. Unser Edelstahl-Schmuck ist anlaufbeständig, wasserfest und behält seinen Glanz." }
    ]}
  ],
  "presets": [ { "name": "ELURA · FAQ", "blocks": [
    { "type": "faq", "settings": { "q": "Ist der Schmuck wirklich wasserfest?", "a": "Ja! Du kannst ihn beim Duschen, Schwimmen und im Alltag tragen. Der Edelstahl rostet nicht und läuft nicht an." } },
    { "type": "faq", "settings": { "q": "Wird der Schmuck grün oder löst Allergien aus?", "a": "Nein. Unser Schmuck ist hypoallergen und nickelarm — sanft zur Haut, auch bei empfindlicher Haut." } },
    { "type": "faq", "settings": { "q": "Wie lange dauert der Versand?", "a": "Wir versenden innert 48h aus der Schweiz. Ab CHF 50 Bestellwert ist der Versand kostenlos." } },
    { "type": "faq", "settings": { "q": "Kann ich umtauschen oder zurückgeben?", "a": "Ja, du hast 14 Tage Rückgaberecht. Schreib uns einfach und wir kümmern uns unkompliziert darum." } },
    { "type": "faq", "settings": { "q": "Wie pflege ich meinen Schmuck?", "a": "Einfach mit einem weichen Tuch abwischen. Kein spezielles Putzmittel nötig — der Glanz bleibt von allein." } }
  ]}]
}
{% endschema %}
