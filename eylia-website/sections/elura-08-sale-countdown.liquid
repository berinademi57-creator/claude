{% comment %} ELURA · Section 08 – Sale-Banner mit Countdown (Dringlichkeit → mehr Käufe) {% endcomment %}
<style>
  .el-sale{--ink:#211d1a;--muted:#7a7168;--gold:#b08d57;background:#f2ebe2;text-align:center;padding:70px 0;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
  .el-sale .wrap{max-width:900px;margin:0 auto;padding:0 24px}
  .el-sale .eyebrow{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:600}
  .el-sale h2{font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(30px,4vw,46px);font-weight:600;margin:12px 0 8px;color:var(--ink)}
  .el-sale p{color:var(--muted);margin:0 0 24px}
  .el-sale .timer{display:flex;justify-content:center;gap:14px;margin:0 0 28px}
  .el-sale .unit{background:var(--ink);color:#f5ece0;border-radius:4px;min-width:72px;padding:12px 6px}
  .el-sale .unit .num{font-size:30px;font-weight:700;line-height:1;font-variant-numeric:tabular-nums}
  .el-sale .unit .lab{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-top:5px}
  .el-sale .btn{display:inline-block;font-size:13px;letter-spacing:.12em;text-transform:uppercase;font-weight:600;
    padding:15px 34px;border-radius:2px;border:1px solid var(--ink);background:var(--ink);color:#f5ece0;text-decoration:none}
  @media(max-width:500px){ .el-sale .unit{min-width:60px} .el-sale .unit .num{font-size:24px} }
</style>
<section class="el-sale">
  <div class="wrap">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <div class="timer" id="elTimer-{{ section.id }}">
      <div class="unit"><div class="num" data-d>00</div><div class="lab">Tage</div></div>
      <div class="unit"><div class="num" data-h>00</div><div class="lab">Std</div></div>
      <div class="unit"><div class="num" data-m>00</div><div class="lab">Min</div></div>
      <div class="unit"><div class="num" data-s>00</div><div class="lab">Sek</div></div>
    </div>
    <a href="{{ section.settings.btn_link }}" class="btn">{{ section.settings.btn_text }}</a>
  </div>
</section>
<script>
(function(){
  var end=new Date("{{ section.settings.end_date }}").getTime();
  var root=document.getElementById("elTimer-{{ section.id }}");
  if(!root||isNaN(end))return;
  function pad(n){return(n<10?"0":"")+n;}
  function tick(){
    var t=end-Date.now();
    if(t<0){t=0;}
    var d=Math.floor(t/864e5),h=Math.floor(t%864e5/36e5),m=Math.floor(t%36e5/6e4),s=Math.floor(t%6e4/1e3);
    root.querySelector("[data-d]").textContent=pad(d);
    root.querySelector("[data-h]").textContent=pad(h);
    root.querySelector("[data-m]").textContent=pad(m);
    root.querySelector("[data-s]").textContent=pad(s);
  }
  tick();setInterval(tick,1000);
})();
</script>

{% schema %}
{
  "name": "ELURA · Sale-Countdown",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleiner Text", "default": "Nur für kurze Zeit" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Sale — bis zu 40% reduziert" },
    { "type": "text", "id": "text", "label": "Text", "default": "Ausgewählte Lieblingsstücke ab CHF 5. Solange der Vorrat reicht." },
    { "type": "text", "id": "end_date", "label": "Enddatum (JJJJ-MM-TT HH:MM)", "default": "2026-12-31 23:59", "info": "Format: 2026-12-31 23:59" },
    { "type": "text", "id": "btn_text", "label": "Button-Text", "default": "Zum Sale" },
    { "type": "url", "id": "btn_link", "label": "Button-Link", "default": "/collections/sale" }
  ],
  "presets": [ { "name": "ELURA · Sale-Countdown" } ]
}
{% endschema %}
