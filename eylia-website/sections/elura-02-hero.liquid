{% comment %} ELURA · Section 02 – Hero (Value Proposition + CTA + Social Proof) {% endcomment %}
<style>
  .el-hero{--ink:#211d1a;--muted:#7a7168;--gold:#b08d57;
    position:relative;min-height:78vh;display:flex;align-items:center;overflow:hidden;
    background:radial-gradient(120% 120% at 80% 10%,#f7efe4 0%,#efe4d4 45%,#e8dccb 100%);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
  .el-hero .wrap{max-width:1240px;margin:0 auto;padding:0 24px;width:100%;
    display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center}
  .el-hero .eyebrow{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:600}
  .el-hero h1{font-family:"Cormorant Garamond",Georgia,serif;font-weight:600;
    font-size:clamp(46px,6.6vw,88px);line-height:1.02;margin:18px 0 20px;color:var(--ink)}
  .el-hero h1 em{font-style:italic;color:var(--gold)}
  .el-hero p.sub{font-size:17px;color:var(--muted);max-width:440px;margin-bottom:20px}
  .el-hero .cta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:22px}
  .el-hero .btn{display:inline-block;font-size:13px;letter-spacing:.12em;text-transform:uppercase;font-weight:600;
    padding:15px 30px;border-radius:2px;border:1px solid var(--ink);transition:.2s;text-decoration:none}
  .el-hero .btn-dark{background:var(--ink);color:#f5ece0}
  .el-hero .btn-dark:hover{background:#000}
  .el-hero .btn-ghost{background:transparent;color:var(--ink)}
  .el-hero .btn-ghost:hover{background:var(--ink);color:#f5ece0}
  .el-hero .proof{display:flex;align-items:center;gap:10px;font-size:13.5px;color:var(--muted)}
  .el-hero .proof .stars{color:var(--gold);letter-spacing:2px}
  .el-hero .visual{position:relative;height:66vh;min-height:440px;border-radius:6px;overflow:hidden;
    box-shadow:0 30px 60px -30px rgba(60,45,30,.4)}
  .el-hero .visual img{width:100%;height:100%;object-fit:cover;display:block}
  @media(max-width:820px){ .el-hero .wrap{grid-template-columns:1fr} .el-hero .visual{display:none} }
</style>
<section class="el-hero">
  <div class="wrap">
    <div>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <p class="sub">{{ section.settings.subheading }}</p>
      <div class="cta">
        <a href="{{ section.settings.btn1_link }}" class="btn btn-dark">{{ section.settings.btn1_text }}</a>
        <a href="{{ section.settings.btn2_link }}" class="btn btn-ghost">{{ section.settings.btn2_text }}</a>
      </div>
      <div class="proof"><span class="stars">★★★★★</span> {{ section.settings.proof_text }}</div>
    </div>
    <div class="visual">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="ELURA">
      {% else %}
        <img src="https://cdn.shopify.com/s/files/1/1035/8548/1052/files/39676ACF-DB1F-4199-AF3C-A172C0835DDA.jpg?v=1783120756" alt="ELURA Schmuck">
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ELURA · Hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleiner Text oben", "default": "ELURA · Neue Kollektion" },
    { "type": "text", "id": "heading", "label": "Überschrift (mit <em> für Gold)", "default": "Schmuck, der <em>bleibt.</em>" },
    { "type": "textarea", "id": "subheading", "label": "Unterzeile", "default": "Zeitlose Armbänder, Halsketten und Ringe aus hochwertigem Edelstahl — wasserfest, anlaufbeständig und hypoallergen." },
    { "type": "text", "id": "btn1_text", "label": "Button 1 Text", "default": "Kollektion entdecken" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 Link", "default": "/collections/all" },
    { "type": "text", "id": "btn2_text", "label": "Button 2 Text", "default": "Bestseller ansehen" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 Link", "default": "/collections/flower" },
    { "type": "text", "id": "proof_text", "label": "Social-Proof-Text", "default": "4.9/5 von über 1.200 zufriedenen Kundinnen" },
    { "type": "image_picker", "id": "image", "label": "Hero-Bild (leer = Standard)" }
  ],
  "presets": [ { "name": "ELURA · Hero" } ]
}
{% endschema %}
