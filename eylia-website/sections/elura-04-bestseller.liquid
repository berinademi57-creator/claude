{% comment %} ELURA · Section 04 – Bestseller (dynamisch, echte Produkte, Quick-Add) {% endcomment %}
<style>
  .el-best{--ink:#211d1a;--muted:#7a7168;--gold:#b08d57;--line:#e5dccf;--sale:#a8443a;
    padding:88px 0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
  .el-best .wrap{max-width:1240px;margin:0 auto;padding:0 24px}
  .el-best .head{text-align:center;max-width:640px;margin:0 auto 52px}
  .el-best .eyebrow{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:600}
  .el-best h2{font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(34px,4.4vw,52px);font-weight:600;margin:12px 0 14px;color:var(--ink)}
  .el-best .head p{color:var(--muted);font-size:16px;margin:0}
  .el-best .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:26px}
  .el-best .card{background:#fff;border:1px solid var(--line);border-radius:4px;overflow:hidden;transition:.25s;position:relative}
  .el-best .card:hover{transform:translateY(-4px);box-shadow:0 22px 40px -26px rgba(60,45,30,.45)}
  .el-best .imgw{position:relative;aspect-ratio:1/1;overflow:hidden;background:#f2ebe2;display:block}
  .el-best .imgw img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
  .el-best .card:hover .imgw img{transform:scale(1.05)}
  .el-best .tag{position:absolute;top:12px;left:12px;background:var(--sale);color:#fff;font-size:10.5px;
    letter-spacing:.1em;text-transform:uppercase;padding:4px 9px;border-radius:2px;font-weight:600}
  .el-best .body{padding:16px}
  .el-best .type{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);font-weight:600}
  .el-best .body h3{font-size:15px;font-weight:500;margin:5px 0 8px;line-height:1.3;color:var(--ink)}
  .el-best .price{font-size:15px;font-weight:600;color:var(--ink)}
  .el-best .price .old{color:var(--muted);text-decoration:line-through;font-weight:400;margin-left:7px;font-size:13.5px}
  .el-best .add{margin-top:13px;width:100%;text-align:center;font-size:12px;letter-spacing:.1em;text-transform:uppercase;
    font-weight:600;padding:11px;border:1px solid var(--ink);background:transparent;color:var(--ink);border-radius:2px;cursor:pointer;transition:.2s}
  .el-best .add:hover{background:var(--ink);color:#f5ece0}
  .el-best .more{text-align:center;margin-top:48px}
  .el-best .btn{display:inline-block;font-size:13px;letter-spacing:.12em;text-transform:uppercase;font-weight:600;
    padding:15px 30px;border-radius:2px;border:1px solid var(--ink);background:var(--ink);color:#f5ece0;text-decoration:none}
  @media(max-width:1000px){ .el-best .grid{grid-template-columns:repeat(3,1fr)} }
  @media(max-width:560px){ .el-best .grid{grid-template-columns:1fr 1fr;gap:16px} .el-best{padding:60px 0} }
</style>
<section class="el-best">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    <div class="grid">
      {% assign coll = section.settings.collection %}
      {% if coll != blank %}
        {% for product in coll.products limit: section.settings.count %}
          {% assign v = product.selected_or_first_available_variant %}
          <div class="card">
            <a class="imgw" href="{{ product.url }}">
              {% if product.compare_at_price > product.price %}<span class="tag">Sale</span>{% endif %}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
            </a>
            <div class="body">
              <div class="type">{{ product.type }}</div>
              <h3>{{ product.title }}</h3>
              <div class="price">
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}<span class="old">{{ product.compare_at_price | money }}</span>{% endif %}
              </div>
              {% if section.settings.show_add %}
                <form method="post" action="{{ routes.cart_add_url }}">
                  <input type="hidden" name="id" value="{{ v.id }}">
                  <button type="submit" class="add" {% unless v.available %}disabled{% endunless %}>
                    {% if v.available %}{{ section.settings.add_text }}{% else %}Ausverkauft{% endif %}
                  </button>
                </form>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <p style="grid-column:1/-1;text-align:center;color:#7a7168">Bitte im Editor eine Collection auswählen (z. B. „Flower" oder „Bestseller").</p>
      {% endif %}
    </div>
    {% if section.settings.btn_text != blank %}
      <div class="more"><a href="{{ section.settings.btn_link }}" class="btn">{{ section.settings.btn_text }}</a></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "ELURA · Bestseller",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleiner Text", "default": "Beliebt bei unseren Kundinnen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Unsere Bestseller" },
    { "type": "text", "id": "subheading", "label": "Unterzeile", "default": "Die Lieblingsstücke, die immer wieder ausverkauft sind — jetzt sichern." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Anzahl Produkte", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "checkbox", "id": "show_add", "label": "„In den Warenkorb\"-Button zeigen", "default": true },
    { "type": "text", "id": "add_text", "label": "Button-Text", "default": "In den Warenkorb" },
    { "type": "text", "id": "btn_text", "label": "Unten-Button Text", "default": "Alle Produkte ansehen" },
    { "type": "url", "id": "btn_link", "label": "Unten-Button Link", "default": "/collections/all" }
  ],
  "presets": [ { "name": "ELURA · Bestseller" } ]
}
{% endschema %}
