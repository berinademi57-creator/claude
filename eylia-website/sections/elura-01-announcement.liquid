{% comment %} ELURA · Section 01 – Ankündigungsbalken (Versand & Trust · Urgency) {% endcomment %}
<style>
  .el-anno{background:{{ section.settings.bg }};color:{{ section.settings.text }};text-align:center;
    font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;padding:9px 16px;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
  .el-anno b{color:{{ section.settings.accent }};font-weight:700}
  @media(max-width:600px){ .el-anno{font-size:11px;letter-spacing:.06em} }
</style>
<div class="el-anno">{{ section.settings.text_content }}</div>

{% schema %}
{
  "name": "ELURA · Ankündigung",
  "tag": "section",
  "settings": [
    { "type": "richtext", "id": "text_content", "label": "Text", "default": "<p>✦ Kostenloser Versand ab <b>CHF 50</b> · Wasserfest & Hypoallergen · Versand innert 48h aus der Schweiz ✦</p>" },
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#211d1a" },
    { "type": "color", "id": "text", "label": "Textfarbe", "default": "#f3ece1" },
    { "type": "color", "id": "accent", "label": "Akzentfarbe", "default": "#b08d57" }
  ],
  "presets": [ { "name": "ELURA · Ankündigung" } ]
}
{% endschema %}
