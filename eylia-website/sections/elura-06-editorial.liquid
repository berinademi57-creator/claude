{% comment %} ELURA · Section 06 – Editorial-Banner (Story/Kollektion → emotionale Bindung) {% endcomment %}
<style>
  .el-ed{--ink:#211d1a;--muted:#7a7168;--gold:#b08d57;background:#f2ebe2;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
  .el-ed .grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;min-height:520px}
  .el-ed.flip .grid{direction:rtl}
  .el-ed.flip .copy{direction:ltr}
  .el-ed .imgw{height:100%;min-height:460px;overflow:hidden}
  .el-ed .imgw img{width:100%;height:100%;object-fit:cover;display:block}
  .el-ed .copy{padding:70px}
  .el-ed .eyebrow{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:600}
  .el-ed h2{font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(32px,4vw,50px);font-weight:600;line-height:1.08;margin:16px 0 18px;color:var(--ink)}
  .el-ed p{color:var(--muted);font-size:16px;margin:0 0 28px;max-width:440px}
  .el-ed .btn{display:inline-block;font-size:13px;letter-spacing:.12em;text-transform:uppercase;font-weight:600;
    padding:15px 30px;border-radius:2px;border:1px solid var(--ink);background:var(--ink);color:#f5ece0;text-decoration:none}
  @media(max-width:820px){ .el-ed .grid,.el-ed.flip .grid{grid-template-columns:1fr;direction:ltr} .el-ed .copy{padding:48px 28px} }
</style>
<section class="el-ed {% if section.settings.flip %}flip{% endif %}">
  <div class="grid">
    <div class="imgw">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}">
      {% else %}
        <img src="https://cdn.shopify.com/s/files/1/1035/8548/1052/files/07F6E33F-F30A-42FF-80EF-4768A9FD735B.jpg?v=1783120756" alt="Flower Kollektion">
      {% endif %}
    </div>
    <div class="copy">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {% if section.settings.btn_text != blank %}<a href="{{ section.settings.btn_link }}" class="btn">{{ section.settings.btn_text }}</a>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ELURA · Editorial-Banner",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleiner Text", "default": "Signature Kollektion" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Die Flower Kollektion" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Filigrane Blüten in vielen handverlesenen Farben — von zartem Rosé bis leuchtendem Türkis. Jedes Stück ein kleines Statement, das zu allem passt." },
    { "type": "text", "id": "btn_text", "label": "Button-Text", "default": "Flower entdecken" },
    { "type": "url", "id": "btn_link", "label": "Button-Link", "default": "/collections/flower" },
    { "type": "image_picker", "id": "image", "label": "Bild (leer = Standard)" },
    { "type": "checkbox", "id": "flip", "label": "Bild rechts statt links", "default": false }
  ],
  "presets": [ { "name": "ELURA · Editorial-Banner" } ]
}
{% endschema %}
