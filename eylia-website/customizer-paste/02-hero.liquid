<style>
.elp02{--ink:#0d0d0d;--paper:#f4f2ec;--gold:#c9a24a;--dim:#8b8880;
  background:var(--ink);color:var(--paper);position:relative;overflow:hidden;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp02 .top{padding:70px 44px 0;position:relative;z-index:2}
.elp02 .eyebrow{display:flex;align-items:center;gap:12px;font-size:11px;letter-spacing:.28em;
  text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:22px}
.elp02 .eyebrow::before{content:"";width:34px;height:1px;background:var(--gold)}
.elp02 h1{font-family:Georgia,"Times New Roman",serif;font-weight:400;font-size:clamp(46px,8vw,128px);
  line-height:.92;letter-spacing:-.01em;margin:0;max-width:1100px}
.elp02 h1 .light{font-weight:300;color:#79766e}
.elp02 h1 .accent{font-style:italic;color:var(--gold)}
.elp02 .row{display:grid;grid-template-columns:1.15fr 1fr;gap:48px;align-items:end;margin-top:44px;position:relative;z-index:2}
.elp02 .copy p{font-size:15.5px;color:#c7c3ba;max-width:400px;line-height:1.7;margin:0 0 30px}
.elp02 .cta{display:flex;align-items:center;gap:26px;flex-wrap:wrap}
.elp02 .btn{display:inline-block;font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:700;
  padding:17px 30px;border:1px solid var(--paper);color:var(--ink);background:var(--paper);text-decoration:none;transition:.25s}
.elp02 .btn:hover{background:var(--gold);border-color:var(--gold)}
.elp02 .link{font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:var(--paper);
  text-decoration:none;border-bottom:1px solid var(--dim);padding-bottom:3px;transition:.2s}
.elp02 .link:hover{border-color:var(--gold);color:var(--gold)}
.elp02 .stat{margin-top:34px;font-size:12px;color:var(--dim);letter-spacing:.04em}
.elp02 .stat b{color:var(--paper)}
.elp02 .media{position:relative}
.elp02 .media .frame{aspect-ratio:4/5;overflow:hidden;transform:translateY(30px);box-shadow:0 40px 80px -30px rgba(0,0,0,.6)}
.elp02 .media .frame img{width:100%;height:100%;object-fit:cover;display:block}
.elp02 .index{position:absolute;right:44px;top:70px;writing-mode:vertical-rl;font-size:11px;letter-spacing:.2em;
  color:var(--dim);text-transform:uppercase;z-index:2}
.elp02 .index b{color:var(--gold)}
.elp02 .bottom-space{height:70px}
@media(max-width:860px){
  .elp02 .row{grid-template-columns:1fr;gap:28px}
  .elp02 .media .frame{transform:none;margin-top:20px}
  .elp02 .index{display:none}
  .elp02 .top{padding:56px 22px 0}
  .elp02 .bottom-space{height:36px}
}
</style>
<section class="elp02">
  <div class="index">Scroll <b>—</b> 01 / 04</div>
  <div class="top">
    <div class="eyebrow">Elura — Neue Kollektion</div>
    <h1>Schmuck mit<br><span class="light">echtem</span> <span class="accent">Charakter</span></h1>
  </div>
  <div class="row" style="padding:0 44px">
    <div class="copy">
      <p>Handgefertigte Armbänder, Ringe und Halsketten in Gold, Kristall und zeitlosen Symbolen — für alle, die Details lieben und Schmuck tragen, der eine Geschichte erzählt.</p>
      <div class="cta">
        <a href="/collections/all" class="btn">Shop All</a>
        <a href="/collections/bestseller" class="link">Bestseller ansehen →</a>
      </div>
      <div class="stat">★★★★★ <b>4.9</b> · über 1.200 Bewertungen</div>
    </div>
    <div class="media">
      <div class="frame">
        <img src="https://cdn.shopify.com/s/files/1/1035/8548/1052/files/8646290F-558A-44E6-82D4-65573699269D.jpg?v=1783344036" alt="ELURA Schmuck">
      </div>
    </div>
  </div>
  <div class="bottom-space"></div>
</section>
