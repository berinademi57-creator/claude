<style>
.elp02{--ink:#111111;--paper:#f7f6f3;--gold:#c9a227;position:relative;min-height:82vh;display:grid;
  grid-template-columns:1fr 1.1fr;background:var(--ink);overflow:hidden;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp02 .side{display:flex;flex-direction:column;justify-content:center;padding:70px 60px;color:#f5f5f0}
.elp02 .eyebrow{font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:var(--gold);font-weight:700}
.elp02 h1{font-family:Georgia,"Times New Roman",serif;font-weight:400;text-transform:uppercase;
  font-size:clamp(42px,6vw,80px);line-height:0.98;letter-spacing:.01em;margin:20px 0 22px;color:#fff}
.elp02 h1 em{font-style:normal;color:var(--gold)}
.elp02 p.sub{font-size:16px;color:#c8c4bc;max-width:400px;margin-bottom:30px;line-height:1.6}
.elp02 .cta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:26px}
.elp02 .btn{display:inline-block;font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;
  padding:16px 28px;border-radius:0;border:1px solid #fff;transition:.2s;text-decoration:none}
.elp02 .btn-solid{background:#fff;color:var(--ink)}
.elp02 .btn-solid:hover{background:var(--gold);border-color:var(--gold);color:#111}
.elp02 .btn-line{background:transparent;color:#fff}
.elp02 .btn-line:hover{background:#fff;color:var(--ink)}
.elp02 .proof{display:flex;align-items:center;gap:10px;font-size:12.5px;color:#c8c4bc;letter-spacing:.04em}
.elp02 .proof .stars{color:var(--gold);letter-spacing:2px}
.elp02 .visual{position:relative;overflow:hidden;background:var(--paper)}
.elp02 .visual img{width:100%;height:100%;object-fit:cover;display:block;min-height:82vh}
@media(max-width:860px){.elp02{grid-template-columns:1fr;min-height:auto}
  .elp02 .visual img{min-height:52vh}.elp02 .side{padding:50px 28px}}
</style>
<section class="elp02">
  <div class="side">
    <span class="eyebrow">ELURA — New Drop</span>
    <h1>Schmuck mit<br><em>Charakter</em></h1>
    <p class="sub">Handgefertigte Armbänder, Ringe und Halsketten in Gold, Kristall und zeitlosen Symbolen. Für alle, die Details lieben.</p>
    <div class="cta">
      <a href="/collections/all" class="btn btn-solid">Shop All</a>
      <a href="/collections/bestseller" class="btn btn-line">Bestseller</a>
    </div>
    <div class="proof"><span class="stars">★★★★★</span> 4.9/5 · 1.200+ Bewertungen</div>
  </div>
  <div class="visual">
    <img src="https://cdn.shopify.com/s/files/1/1035/8548/1052/files/8646290F-558A-44E6-82D4-65573699269D.jpg?v=1783344036" alt="ELURA Schmuck">
  </div>
</section>
