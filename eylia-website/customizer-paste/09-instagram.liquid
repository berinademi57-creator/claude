<style>
.elp09{--gold:#b08d57;--muted:#7a7168;--ink:#211d1a;padding:80px 0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp09 .wrap{max-width:1240px;margin:0 auto;padding:0 24px}
.elp09 .head{text-align:center;max-width:640px;margin:0 auto 40px}
.elp09 .eyebrow{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:600}
.elp09 h2{font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(32px,4vw,48px);font-weight:600;margin:12px 0 14px;color:var(--ink)}
.elp09 .head p{color:var(--muted);margin:0}
.elp09 .grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}
.elp09 .grid a{aspect-ratio:1/1;overflow:hidden;border-radius:3px;display:block}
.elp09 .grid img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.elp09 .grid a:hover img{transform:scale(1.1)}
@media(max-width:1000px){.elp09 .grid{grid-template-columns:repeat(4,1fr)}}
@media(max-width:560px){.elp09 .grid{grid-template-columns:repeat(3,1fr)}}
</style>
<section class="elp09">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">@elura</span>
      <h2>Getragen &amp; geliebt</h2>
      <p>Tagge uns mit #elura für die Chance, hier gefeatured zu werden.</p>
    </div>
    <div class="grid">
      <a href="https://instagram.com"><img src="https://cdn.shopify.com/s/files/1/1035/8548/1052/files/Go2boho-Buntes-Evil-Eye-Perlen-armband-mit.jpg?v=1783285370" alt=""></a>
      <a href="https://instagram.com"><img src="https://cdn.shopify.com/s/files/1/1035/8548/1052/files/Go2boho-Kristall-kette-Choker-Halskette-Gold-Perle.png?v=1783285403" alt=""></a>
      <a href="https://instagram.com"><img src="https://cdn.shopify.com/s/files/1/1035/8548/1052/files/Go2boho-Geflochtene-Kristall-Perlen-Ohrringe-Boho-Samen.jpg?v=1783285425" alt=""></a>
      <a href="https://instagram.com"><img src="https://cdn.shopify.com/s/files/1/1035/8548/1052/files/Go2boho-Damen-Handgefertigtes-Gold-Elastisches-Armband-Mehrschichtiges.png?v=1783285115" alt=""></a>
      <a href="https://instagram.com"><img src="https://cdn.shopify.com/s/files/1/1035/8548/1052/files/Go2boho-Gro-handel-8mm-Amethyst-Natural-Lava.jpg?v=1783285278" alt=""></a>
