<style>
.elp09{--gold:#c9a227;--muted:#6b6b6b;--ink:#111111;padding:80px 0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp09 .wrap{max-width:1240px;margin:0 auto;padding:0 24px}
.elp09 .head{text-align:center;max-width:640px;margin:0 auto 36px}
.elp09 .eyebrow{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);font-weight:700}
.elp09 h2{font-family:Georgia,"Times New Roman",serif;text-transform:uppercase;font-size:clamp(26px,3.4vw,40px);
  font-weight:400;margin:12px 0 14px;color:var(--ink)}
.elp09 .head p{color:var(--muted);margin:0}
.elp09 .grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}
.elp09 .grid a{aspect-ratio:1/1;overflow:hidden;display:block;background:#f7f6f3}
.elp09 .grid img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.elp09 .grid a:hover img{transform:scale(1.08)}
@media(max-width:1000px){.elp09 .grid{grid-template-columns:repeat(4,1fr)}}
@media(max-width:560px){.elp09 .grid{grid-template-columns:repeat(3,1fr)}}
</style>
<section class="elp09">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">@elura</span>
      <h2>Getragen &amp; geliebt</h2>
      <p>Tagge uns mit #elura für die Chance, hier gefeatured zu werden.</p>
    </div>
    <div class="grid">
      {% assign c = collections['gold-momente'] %}
      {% if c %}
        {% for product in c.products limit: 6 %}
          <a href="{{ product.url }}"><img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" loading="lazy"></a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
