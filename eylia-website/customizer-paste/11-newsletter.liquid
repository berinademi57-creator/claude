<style>
.elp11{--ink:#211d1a;--muted:#7a7168;--gold:#b08d57;text-align:center;padding:88px 0;
  background:linear-gradient(120% 120% at 20% 0%,#f2e7d6,#e9dcc7);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp11 .wrap{max-width:620px;margin:0 auto;padding:0 24px}
.elp11 .eyebrow{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:600}
.elp11 h2{font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(32px,4vw,48px);font-weight:600;margin:12px 0;color:var(--ink)}
.elp11 p{color:var(--muted);margin:0 auto 26px;max-width:480px}
.elp11 form{display:flex;gap:10px;max-width:440px;margin:0 auto;flex-wrap:wrap;justify-content:center}
.elp11 input[type=email]{flex:1;min-width:220px;padding:15px 18px;border:1px solid var(--ink);border-radius:2px;background:#fff;font-size:14px}
.elp11 button{font-size:13px;letter-spacing:.12em;text-transform:uppercase;font-weight:600;padding:15px 30px;
  border-radius:2px;border:1px solid var(--ink);background:var(--ink);color:#f5ece0;cursor:pointer}
.elp11 .ok{color:#2c7a4b;font-weight:600;margin-top:14px}
.elp11 .note{font-size:12px;color:var(--muted);margin-top:14px}
</style>
<section class="elp11">
  <div class="wrap">
    <span class="eyebrow">Werde Teil der Familie</span>
    <h2>10% auf deine erste Bestellung</h2>
    <p>Melde dich für unseren Newsletter an und erhalte exklusive Angebote, neue Kollektionen und deinen Willkommensrabatt.</p>
    {% form 'customer' %}
      {% if form.posted_successfully? %}
        <p class="ok">✓ Danke! Prüfe dein Postfach für deinen 10%-Code.</p>
      {% else %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="Deine E-Mail-Adresse" required>
        <button type="submit">Anmelden</button>
      {% endif %}
    {% endform %}
    <p class="note">Kein Spam. Abmeldung jederzeit möglich.</p>
  </div>
</section>
