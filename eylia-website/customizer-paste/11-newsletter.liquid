<style>
.elp11{--gold:#c9a24a;text-align:center;padding:110px 24px;background:#0d0d0d;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp11 .wrap{max-width:560px;margin:0 auto}
.elp11 .eyebrow{font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:20px}
.elp11 h2{font-family:Georgia,"Times New Roman",serif;font-size:clamp(30px,4.2vw,52px);font-weight:400;
  line-height:1.1;margin:0 0 18px;color:#fff}
.elp11 h2 em{font-style:italic;color:var(--gold)}
.elp11 p{color:#a8a49a;margin:0 auto 34px;max-width:420px;font-size:14.5px}
.elp11 form{display:flex;gap:0;max-width:420px;margin:0 auto;border-bottom:1px solid #4a4a4a;padding-bottom:12px}
.elp11 input[type=email]{flex:1;background:none;border:none;color:#fff;font-size:15px;padding:8px 0;outline:none}
.elp11 input[type=email]::placeholder{color:#6f6c64}
.elp11 button{background:none;border:none;font-size:12px;letter-spacing:.14em;text-transform:uppercase;
  font-weight:700;color:var(--gold);cursor:pointer;white-space:nowrap;padding:8px 0 8px 16px}
.elp11 button:hover{color:#fff}
.elp11 .ok{color:#8fd39a;font-weight:600;margin-top:16px;font-size:14px}
.elp11 .note{font-size:11px;color:#6f6c64;margin-top:18px;letter-spacing:.02em}
</style>
<section class="elp11">
  <div class="wrap">
    <div class="eyebrow">Werde Teil der Familie</div>
    <h2>10% auf deine <em>erste Bestellung</em></h2>
    <p>Melde dich für unseren Newsletter an und erhalte exklusive Angebote, neue Kollektionen und deinen Willkommensrabatt.</p>
    {% form 'customer' %}
      {% if form.posted_successfully? %}
        <p class="ok">✓ Danke! Prüfe dein Postfach für deinen 10%-Code.</p>
      {% else %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="Deine E-Mail-Adresse" required>
        <button type="submit">Anmelden →</button>
      {% endif %}
    {% endform %}
    <p class="note">Kein Spam. Abmeldung jederzeit möglich.</p>
  </div>
</section>
