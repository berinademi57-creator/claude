<style>
.elp11{--ink:#111111;--muted:#6b6b6b;--gold:#c9a227;text-align:center;padding:90px 0;background:#111111;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp11 .wrap{max-width:600px;margin:0 auto;padding:0 24px}
.elp11 .eyebrow{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);font-weight:700}
.elp11 h2{font-family:Georgia,"Times New Roman",serif;text-transform:uppercase;font-size:clamp(28px,3.6vw,42px);
  font-weight:400;margin:12px 0;color:#fff}
.elp11 p{color:#a8a39a;margin:0 auto 26px;max-width:460px}
.elp11 form{display:flex;gap:10px;max-width:440px;margin:0 auto;flex-wrap:wrap;justify-content:center}
.elp11 input[type=email]{flex:1;min-width:220px;padding:15px 18px;border:1px solid #444;background:#1a1a1a;color:#fff;font-size:14px}
.elp11 input[type=email]::placeholder{color:#8f897e}
.elp11 button{font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;padding:15px 28px;
  border:1px solid #fff;background:#fff;color:#111;cursor:pointer}
.elp11 button:hover{background:var(--gold);border-color:var(--gold)}
.elp11 .ok{color:#7fd88f;font-weight:600;margin-top:14px}
.elp11 .note{font-size:11.5px;color:#8f897e;margin-top:14px}
</style>
<section class="elp11">
  <div class="wrap">
    <span class="eyebrow">Werde Teil der Familie</span>
    <h2>10% auf deine erste Bestellung</h2>
    <p>Melde dich für unseren Newsletter an und erhalte exklusive Angebote, neue Kollektionen und deinen Willkommensrabatt.</p>
    {% form 'customer' %}
      {% if form.posted_successfully? %}
        <p class="ok">✓ Danke! Prüfe dein Postfach für deinen 10%-Code.</p>
      {% else %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="Deine E-Mail-Adresse" required>
        <button type="submit">Anmelden</button>
      {% endif %}
    {% endform %}
    <p class="note">Kein Spam. Abmeldung jederzeit möglich.</p>
  </div>
</section>
