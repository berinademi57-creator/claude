<style>
.elp08{--gold:#e3c26b;position:relative;padding:130px 24px;text-align:center;overflow:hidden;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp08 .bg{position:absolute;inset:0;z-index:0}
.elp08 .bg img{width:100%;height:100%;object-fit:cover;filter:brightness(.4) saturate(.9)}
.elp08 .bg::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,10,10,.35),rgba(10,10,10,.75))}
.elp08 .inner{position:relative;z-index:1;max-width:640px;margin:0 auto;color:#f4f2ec}
.elp08 .eyebrow{font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:18px}
.elp08 h2{font-family:Georgia,"Times New Roman",serif;font-size:clamp(32px,4.6vw,58px);font-weight:400;margin:0 0 14px}
.elp08 p{color:#d8d5cc;margin:0 0 34px;font-size:15px}
.elp08 .timer{font-family:Georgia,serif;font-size:clamp(24px,3.4vw,38px);letter-spacing:.05em;color:#fff;margin-bottom:34px}
.elp08 .timer span{color:var(--gold);font-size:11px;letter-spacing:.1em;text-transform:uppercase;
  display:inline-block;vertical-align:middle;margin:0 8px;font-family:-apple-system,sans-serif}
.elp08 .btn{display:inline-block;font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:700;
  padding:17px 34px;border:1px solid #fff;color:#fff;text-decoration:none;transition:.25s}
.elp08 .btn:hover{background:#fff;color:#0d0d0d}
</style>
<section class="elp08">
  <div class="bg"><img src="https://cdn.shopify.com/s/files/1/1035/8548/1052/files/74C17C41-34A9-427F-BFEC-7067B4AC04A7.jpg?v=1783343396" alt=""></div>
  <div class="inner">
    <div class="eyebrow">Nur für kurze Zeit</div>
    <h2>Gold-Momente</h2>
    <p>Unsere vergoldeten Lieblingsstücke — solange der Vorrat reicht.</p>
    <div class="timer" id="elp08-timer">
      <span data-d>00</span>T <span></span><span data-h>00</span>Std <span></span><span data-m>00</span>Min <span></span><span data-s>00</span>Sek
    </div>
    <a href="/collections/gold-momente" class="btn">Kollektion ansehen</a>
  </div>
</section>
<script>
(function(){
  var end=new Date("2026-09-30T23:59:00").getTime();
  var root=document.getElementById("elp08-timer");
  if(!root)return;
  function pad(n){return(n<10?"0":"")+n;}
  function tick(){
    var t=end-Date.now(); if(t<0){t=0;}
    var d=Math.floor(t/864e5),h=Math.floor(t%864e5/36e5),m=Math.floor(t%36e5/6e4),s=Math.floor(t%6e4/1e3);
    root.querySelector("[data-d]").textContent=pad(d);
    root.querySelector("[data-h]").textContent=pad(h);
    root.querySelector("[data-m]").textContent=pad(m);
    root.querySelector("[data-s]").textContent=pad(s);
  }
  tick();setInterval(tick,1000);
})();
</script>
