<style>
.elp08{--ink:#111111;--muted:#6b6b6b;--gold:#c9a227;background:#f7f6f3;text-align:center;padding:70px 0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp08 .wrap{max-width:900px;margin:0 auto;padding:0 24px}
.elp08 .eyebrow{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);font-weight:700}
.elp08 h2{font-family:Georgia,"Times New Roman",serif;text-transform:uppercase;font-size:clamp(28px,3.6vw,42px);
  font-weight:400;margin:12px 0 8px;color:var(--ink)}
.elp08 p{color:var(--muted);margin:0 0 24px}
.elp08 .timer{display:flex;justify-content:center;gap:12px;margin:0 0 28px}
.elp08 .unit{background:var(--ink);color:#fff;min-width:70px;padding:12px 6px}
.elp08 .unit .num{font-size:28px;font-weight:700;line-height:1;font-variant-numeric:tabular-nums}
.elp08 .unit .lab{font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-top:5px}
.elp08 .btn{display:inline-block;font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;
  padding:16px 32px;border:1px solid var(--ink);background:var(--ink);color:#fff;text-decoration:none}
.elp08 .btn:hover{background:transparent;color:var(--ink)}
@media(max-width:500px){.elp08 .unit{min-width:58px}.elp08 .unit .num{font-size:22px}}
</style>
<section class="elp08">
  <div class="wrap">
    <span class="eyebrow">Nur für kurze Zeit</span>
    <h2>Gold-Momente</h2>
    <p>Unsere vergoldeten Lieblingsstücke — solange der Vorrat reicht.</p>
    <div class="timer" id="elp08-timer">
      <div class="unit"><div class="num" data-d>00</div><div class="lab">Tage</div></div>
      <div class="unit"><div class="num" data-h>00</div><div class="lab">Std</div></div>
      <div class="unit"><div class="num" data-m>00</div><div class="lab">Min</div></div>
      <div class="unit"><div class="num" data-s>00</div><div class="lab">Sek</div></div>
    </div>
    <a href="/collections/gold-momente" class="btn">Kollektion ansehen</a>
  </div>
</section>
<script>
(function(){
  var end=new Date("2026-09-30T23:59:00").getTime();
  var root=document.getElementById("elp08-timer");
  if(!root)return;
  function pad(n){return(n<10?"0":"")+n;}
  function tick(){
    var t=end-Date.now(); if(t<0){t=0;}
    var d=Math.floor(t/864e5),h=Math.floor(t%864e5/36e5),m=Math.floor(t%36e5/6e4),s=Math.floor(t%6e4/1e3);
    root.querySelector("[data-d]").textContent=pad(d);
    root.querySelector("[data-h]").textContent=pad(h);
    root.querySelector("[data-m]").textContent=pad(m);
    root.querySelector("[data-s]").textContent=pad(s);
  }
  tick();setInterval(tick,1000);
})();
</script>
