<style>
.elp08{--ink:#211d1a;--muted:#7a7168;--gold:#b08d57;background:#f2ebe2;text-align:center;padding:70px 0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp08 .wrap{max-width:900px;margin:0 auto;padding:0 24px}
.elp08 .eyebrow{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:600}
.elp08 h2{font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(30px,4vw,46px);font-weight:600;margin:12px 0 8px;color:var(--ink)}
.elp08 p{color:var(--muted);margin:0 0 24px}
.elp08 .timer{display:flex;justify-content:center;gap:14px;margin:0 0 28px}
.elp08 .unit{background:var(--ink);color:#f5ece0;border-radius:4px;min-width:72px;padding:12px 6px}
.elp08 .unit .num{font-size:30px;font-weight:700;line-height:1;font-variant-numeric:tabular-nums}
.elp08 .unit .lab{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-top:5px}
.elp08 .btn{display:inline-block;font-size:13px;letter-spacing:.12em;text-transform:uppercase;font-weight:600;
  padding:15px 34px;border-radius:2px;border:1px solid var(--ink);background:var(--ink);color:#f5ece0;text-decoration:none}
@media(max-width:500px){.elp08 .unit{min-width:60px}.elp08 .unit .num{font-size:24px}}
</style>
<section class="elp08">
  <div class="wrap">
    <span class="eyebrow">Nur für kurze Zeit</span>
    <h2>Sale — bis zu 40% reduziert</h2>
    <p>Ausgewählte Lieblingsstücke ab CHF 5. Solange der Vorrat reicht.</p>
    <div class="timer" id="elp08-timer">
      <div class="unit"><div class="num" data-d>00</div><div class="lab">Tage</div></div>
      <div class="unit"><div class="num" data-h>00</div><div class="lab">Std</div></div>
      <div class="unit"><div class="num" data-m>00</div><div class="lab">Min</div></div>
      <div class="unit"><div class="num" data-s>00</div><div class="lab">Sek</div></div>
    </div>
    <a href="/collections/sale" class="btn">Zum Sale</a>
  </div>
</section>
<script>
(function(){
  var end=new Date("2026-12-31T23:59:00").getTime();
  var root=document.getElementById("elp08-timer");
  if(!root)return;
  function pad(n){return(n<10?"0":"")+n;}
  function tick(){
    var t=end-Date.now(); if(t<0){t=0;}
    var d=Math.floor(t/864e5),h=Math.floor(t%864e5/36e5),m=Math.floor(t%36e5/6e4),s=Math.floor(t%6e4/1e3);
    root.querySelector("[data-d]").textContent=pad(d);
    root.querySelector("[data-h]").textContent=pad(h);
    root.querySelector("[data-m]").textContent=pad(m);
    root.querySelector("[data-s]").textContent=pad(s);
  }
  tick();setInterval(tick,1000);
})();
</script>
