<style>
.elp03{--ink:#211d1a;--muted:#7a7168;--line:#e5dccf;background:#f2ebe2;border-top:1px solid var(--line);
  border-bottom:1px solid var(--line);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp03 .grid{max-width:1240px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr)}
.elp03 .item{padding:26px 18px;text-align:center;border-right:1px solid var(--line)}
