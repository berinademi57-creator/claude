.elp03 .ic{font-size:24px;margin-bottom:8px}
.elp03 h4{font-size:13.5px;letter-spacing:.09em;text-transform:uppercase;margin:0 0 3px;color:var(--ink)}
.elp03 p{font-size:12.5px;color:var(--muted);margin:0}
@media(max-width:700px){.elp03 .grid{grid-template-columns:1fr 1fr}.elp03 .item:nth-child(2){border-right:none}
