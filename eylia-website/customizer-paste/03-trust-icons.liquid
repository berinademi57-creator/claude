<style>
.elp03{--ink:#111111;--muted:#6b6b6b;--line:#e8e6e1;background:#f7f6f3;border-top:1px solid var(--line);
  border-bottom:1px solid var(--line);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp03 .grid{max-width:1240px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr)}
.elp03 .item{padding:28px 18px;text-align:center;border-right:1px solid var(--line)}
.elp03 .item:last-child{border-right:none}
.elp03 .ic{font-size:22px;margin-bottom:8px}
.elp03 h4{font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;margin:0 0 3px;color:var(--ink);font-weight:700}
.elp03 p{font-size:12px;color:var(--muted);margin:0}
@media(max-width:700px){.elp03 .grid{grid-template-columns:1fr 1fr}.elp03 .item:nth-child(2){border-right:none}
  .elp03 .item{border-bottom:1px solid var(--line)}}
</style>
<div class="elp03">
  <div class="grid">
    <div class="item"><div class="ic">✋</div><h4>Handgefertigt</h4><p>Mit Liebe zum Detail</p></div>
    <div class="item"><div class="ic">📏</div><h4>Verstellbar</h4><p>Passt sich flexibel an</p></div>
    <div class="item"><div class="ic">✨</div><h4>Gold &amp; Kristall</h4><p>Zeitlose Symbole</p></div>
    <div class="item"><div class="ic">📦</div><h4>Sicher verpackt</h4><p>Mit Sendungsverfolgung</p></div>
  </div>
</div>
