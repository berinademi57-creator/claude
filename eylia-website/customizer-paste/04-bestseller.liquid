<style>
.elp04{--ink:#0d0d0d;--muted:#6f6c64;--gold:#a9832f;--line:#e6e3da;padding:100px 0 90px;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp04 .wrap{max-width:1240px;margin:0 auto;padding:0 24px}
.elp04 .head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:44px}
.elp04 .head .lead{display:flex;align-items:baseline;gap:16px}
.elp04 .lead .num{font-family:Georgia,serif;font-style:italic;font-size:15px;color:var(--gold)}
.elp04 h2{font-family:Georgia,"Times New Roman",serif;font-size:clamp(30px,3.6vw,46px);font-weight:400;
  margin:0;color:var(--ink);letter-spacing:-.005em}
.elp04 .head a{font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--ink);
  border-bottom:1px solid var(--ink);padding-bottom:2px;white-space:nowrap;text-decoration:none;flex-shrink:0}
.elp04 .grid{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:1fr;gap:22px}
.elp04 .card{position:relative;display:flex;flex-direction:column}
.elp04 .card.feature{grid-column:span 2;grid-row:span 2}
.elp04 .imgw{position:relative;overflow:hidden;background:#f4f2ec;display:block;aspect-ratio:1/1;flex:1}
.elp04 .card.feature .imgw{aspect-ratio:auto;height:100%}
.elp04 .imgw img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.8,.2,1)}
.elp04 .card:hover .imgw img{transform:scale(1.05)}
.elp04 .quickadd{position:absolute;left:0;right:0;bottom:0;padding:12px;transform:translateY(100%);
  transition:transform .25s ease;background:linear-gradient(to top,rgba(13,13,13,.88),rgba(13,13,13,0))}
.elp04 .card:hover .quickadd{transform:translateY(0)}
.elp04 .quickadd form{margin:0}
.elp04 .quickadd button{width:100%;font-size:11px;letter-spacing:.12em;text-transform:uppercase;font-weight:700;
  padding:12px;border:1px solid #fff;background:transparent;color:#fff;cursor:pointer;transition:.2s}
.elp04 .quickadd button:hover{background:#fff;color:var(--ink)}
.elp04 .tag{position:absolute;top:12px;left:12px;background:var(--ink);color:#fff;font-size:9.5px;
  letter-spacing:.12em;text-transform:uppercase;padding:5px 9px;font-weight:700;z-index:2}
.elp04 .body{padding:14px 2px 0}
.elp04 .type{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);font-weight:700}
.elp04 .body h3{font-size:14px;font-weight:500;margin:5px 0 5px;line-height:1.3;color:var(--ink)}
.elp04 .body h3 a{color:inherit;text-decoration:none}
.elp04 .price{font-size:13.5px;font-weight:700;color:var(--ink)}
.elp04 .empty{grid-column:1/-1;text-align:center;color:var(--muted);padding:40px 0}
@media(max-width:1000px){.elp04 .grid{grid-template-columns:repeat(3,1fr)}.elp04 .card.feature{grid-column:span 2}}
@media(max-width:640px){.elp04 .grid{grid-template-columns:1fr 1fr;gap:14px}.elp04 .card.feature{grid-column:span 2;grid-row:span 1}
  .elp04{padding:64px 0}.elp04 .head{flex-direction:column;align-items:flex-start;gap:10px}
  .elp04 .quickadd{position:static;transform:none;background:none;padding:8px 0 0}
  .elp04 .quickadd button{border:1px solid var(--ink);color:var(--ink)}.elp04 .quickadd button:hover{background:var(--ink);color:#fff}}
</style>
<section class="elp04">
  <div class="wrap">
    <div class="head">
      <div class="lead"><span class="num">(02)</span><h2>Bestseller</h2></div>
      <a href="/collections/bestseller">Alle Bestseller →</a>
    </div>
    <div class="grid">
      {% assign coll = collections['bestseller'] %}
      {% if coll and coll.products.size > 0 %}
        {% for product in coll.products limit: 7 %}
          {% assign v = product.selected_or_first_available_variant %}
          <div class="card{% if forloop.first %} feature{% endif %}">
            <div class="imgw">
              {% if forloop.index <= 2 %}<span class="tag">Bestseller</span>{% endif %}
              <a href="{{ product.url }}"><img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy"></a>
              <div class="quickadd">
                <form method="post" action="/cart/add">
                  <input type="hidden" name="id" value="{{ v.id }}">
                  <button type="submit" {% unless v.available %}disabled{% endunless %}>
                    {% if v.available %}In den Warenkorb{% else %}Ausverkauft{% endif %}
                  </button>
                </form>
              </div>
            </div>
            <div class="body">
              <div class="type">{{ product.type }}</div>
              <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <div class="price">{{ product.price | money }}</div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <p class="empty">Sobald Produkte mit dem Tag „Bestseller" markiert sind, erscheinen sie hier automatisch.</p>
      {% endif %}
    </div>
  </div>
</section>
