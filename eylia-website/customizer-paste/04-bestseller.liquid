<style>
.elp04{--ink:#211d1a;--muted:#7a7168;--gold:#b08d57;--line:#e5dccf;--sale:#a8443a;padding:88px 0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp04 .wrap{max-width:1240px;margin:0 auto;padding:0 24px}
.elp04 .head{text-align:center;max-width:640px;margin:0 auto 52px}
.elp04 .eyebrow{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:600}
.elp04 h2{font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(34px,4.4vw,52px);font-weight:600;margin:12px 0 14px;color:var(--ink)}
.elp04 .head p{color:var(--muted);font-size:16px;margin:0}
.elp04 .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:26px}
.elp04 .card{background:#fff;border:1px solid var(--line);border-radius:4px;overflow:hidden;transition:.25s;position:relative}
.elp04 .card:hover{transform:translateY(-4px);box-shadow:0 22px 40px -26px rgba(60,45,30,.45)}
.elp04 .imgw{position:relative;aspect-ratio:1/1;overflow:hidden;background:#f2ebe2;display:block}
.elp04 .imgw img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.elp04 .card:hover .imgw img{transform:scale(1.05)}
.elp04 .tag{position:absolute;top:12px;left:12px;background:var(--ink);color:#fff;font-size:10.5px;
  letter-spacing:.1em;text-transform:uppercase;padding:4px 9px;border-radius:2px;font-weight:600}
.elp04 .body{padding:16px}
.elp04 .type{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);font-weight:600}
.elp04 .body h3{font-size:15px;font-weight:500;margin:5px 0 8px;line-height:1.3;color:var(--ink)}
.elp04 .price{font-size:15px;font-weight:600;color:var(--ink)}
.elp04 .add{margin-top:13px;width:100%;text-align:center;font-size:12px;letter-spacing:.1em;text-transform:uppercase;
  font-weight:600;padding:11px;border:1px solid var(--ink);background:transparent;color:var(--ink);border-radius:2px;cursor:pointer;transition:.2s}
.elp04 .add:hover{background:var(--ink);color:#f5ece0}
.elp04 .more{text-align:center;margin-top:48px}
@media(max-width:1000px){.elp04 .grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:560px){.elp04 .grid{grid-template-columns:1fr 1fr;gap:16px}.elp04{padding:60px 0}}
</style>
