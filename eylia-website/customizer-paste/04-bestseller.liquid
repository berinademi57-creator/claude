<style>
.elp04{--ink:#111111;--muted:#6b6b6b;--gold:#c9a227;--line:#e8e6e1;padding:90px 0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp04 .wrap{max-width:1240px;margin:0 auto;padding:0 24px}
.elp04 .head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:40px;
  border-bottom:1px solid var(--line);padding-bottom:24px}
.elp04 .eyebrow{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);font-weight:700}
.elp04 h2{font-family:Georgia,"Times New Roman",serif;text-transform:uppercase;font-size:clamp(28px,3.6vw,42px);
  font-weight:400;margin:10px 0 0;color:var(--ink);letter-spacing:.01em}
.elp04 .head a{font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:var(--ink);
  border-bottom:1px solid var(--ink);padding-bottom:2px;white-space:nowrap;text-decoration:none}
.elp04 .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
.elp04 .card{position:relative}
.elp04 .imgw{position:relative;aspect-ratio:1/1;overflow:hidden;background:#f7f6f3;display:block}
.elp04 .imgw img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.elp04 .card:hover .imgw img{transform:scale(1.04)}
.elp04 .tag{position:absolute;top:12px;left:12px;background:var(--ink);color:#fff;font-size:10px;
  letter-spacing:.1em;text-transform:uppercase;padding:4px 9px;font-weight:700}
.elp04 .body{padding:14px 2px 0}
.elp04 .type{font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);font-weight:700}
.elp04 .body h3{font-size:14.5px;font-weight:500;margin:5px 0 8px;line-height:1.3;color:var(--ink)}
.elp04 .price{font-size:14px;font-weight:700;color:var(--ink)}
.elp04 .add{margin-top:11px;width:100%;text-align:center;font-size:11px;letter-spacing:.1em;text-transform:uppercase;
  font-weight:700;padding:11px;border:1px solid var(--ink);background:transparent;color:var(--ink);cursor:pointer;transition:.2s}
.elp04 .add:hover{background:var(--ink);color:#fff}
.elp04 .empty{grid-column:1/-1;text-align:center;color:var(--muted);padding:40px 0}
@media(max-width:1000px){.elp04 .grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:560px){.elp04 .grid{grid-template-columns:1fr 1fr;gap:14px}.elp04{padding:56px 0}
  .elp04 .head{flex-direction:column;align-items:flex-start;gap:10px}}
</style>
<section class="elp04">
  <div class="wrap">
    <div class="head">
      <div><span class="eyebrow">Meistverkauft</span><h2>Bestseller</h2></div>
      <a href="/collections/bestseller">Alle ansehen →</a>
    </div>
    <div class="grid">
      {% assign coll = collections['bestseller'] %}
      {% if coll and coll.products.size > 0 %}
        {% for product in coll.products limit: 8 %}
          {% assign v = product.selected_or_first_available_variant %}
          <div class="card">
            <a class="imgw" href="{{ product.url }}">
              {% if forloop.index <= 2 %}<span class="tag">Bestseller</span>{% endif %}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
            </a>
            <div class="body">
              <div class="type">{{ product.type }}</div>
              <h3><a href="{{ product.url }}" style="color:inherit;text-decoration:none">{{ product.title }}</a></h3>
              <div class="price">{{ product.price | money }}</div>
              <form method="post" action="/cart/add">
                <input type="hidden" name="id" value="{{ v.id }}">
                <button type="submit" class="add" {% unless v.available %}disabled{% endunless %}>
                  {% if v.available %}In den Warenkorb{% else %}Ausverkauft{% endif %}
                </button>
              </form>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <p class="empty">Sobald Produkte mit dem Tag „Bestseller" markiert sind, erscheinen sie hier automatisch.</p>
      {% endif %}
    </div>
  </div>
</section>
