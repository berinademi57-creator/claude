<style>
.elp06{--ink:#111111;--muted:#6b6b6b;--gold:#c9a227;background:#f7f6f3;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp06 .grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;min-height:520px}
.elp06 .imgw{height:100%;min-height:460px;overflow:hidden}
.elp06 .imgw img{width:100%;height:100%;object-fit:cover;display:block}
.elp06 .copy{padding:70px}
.elp06 .eyebrow{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);font-weight:700}
.elp06 h2{font-family:Georgia,"Times New Roman",serif;text-transform:uppercase;font-size:clamp(30px,4vw,46px);
  font-weight:400;line-height:1.1;margin:16px 0 18px;color:var(--ink)}
.elp06 p{color:var(--muted);font-size:16px;margin:0 0 28px;max-width:440px;line-height:1.6}
.elp06 .btn{display:inline-block;font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;
  padding:16px 30px;border:1px solid var(--ink);background:var(--ink);color:#fff;text-decoration:none}
.elp06 .btn:hover{background:transparent;color:var(--ink)}
@media(max-width:820px){.elp06 .grid{grid-template-columns:1fr}.elp06 .copy{padding:48px 28px}}
</style>
{% assign c = collections['glucksbringer'] %}
<section class="elp06">
  <div class="grid">
    <div class="imgw">
      {% if c and c.products.first %}
        <img src="{{ c.products.first.featured_image | image_url: width: 1000 }}" alt="Glücksbringer Kollektion">
      {% endif %}
    </div>
    <div class="copy">
      <span class="eyebrow">Signature Kollektion</span>
      <h2>Glücksbringer</h2>
      <p>Kleeblatt, Evil Eye &amp; Co. — kleine Symbole mit großer Bedeutung. Kombiniert mit Gold- und Kristall-Details für ein Statement, das mehr erzählt als nur Schmuck.</p>
      {% if c %}<a href="{{ c.url }}" class="btn">Kollektion entdecken</a>{% endif %}
    </div>
  </div>
</section>
