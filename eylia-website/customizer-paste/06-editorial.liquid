<style>
.elp06{--ink:#211d1a;--muted:#7a7168;--gold:#b08d57;background:#f2ebe2;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp06 .grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;min-height:520px}
.elp06 .imgw{height:100%;min-height:460px;overflow:hidden}
.elp06 .imgw img{width:100%;height:100%;object-fit:cover;display:block}
.elp06 .copy{padding:70px}
.elp06 .eyebrow{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:600}
.elp06 h2{font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(32px,4vw,50px);font-weight:600;line-height:1.08;margin:16px 0 18px;color:var(--ink)}
.elp06 p{color:var(--muted);font-size:16px;margin:0 0 28px;max-width:440px}
.elp06 .btn{display:inline-block;font-size:13px;letter-spacing:.12em;text-transform:uppercase;font-weight:600;
  padding:15px 30px;border-radius:2px;border:1px solid var(--ink);background:var(--ink);color:#f5ece0;text-decoration:none}
@media(max-width:820px){.elp06 .grid{grid-template-columns:1fr}.elp06 .copy{padding:48px 28px}}
</style>
<section class="elp06">
  <div class="grid">
    <div class="imgw">
      <img src="https://cdn.shopify.com/s/files/1/1035/8548/1052/files/07F6E33F-F30A-42FF-80EF-4768A9FD735B.jpg?v=1783120756" alt="Flower Kollektion">
    </div>
    <div class="copy">
      <span class="eyebrow">Signature Kollektion</span>
      <h2>Die Flower Kollektion</h2>
      <p>Filigrane Blüten in vielen handverlesenen Farben — von zartem Rosé bis leuchtendem Türkis. Jedes Stück ein kleines Statement, das zu allem passt.</p>
      <a href="/collections/flower" class="btn">Flower entdecken</a>
    </div>
  </div>
</section>
