<style>
.elp06{--ink:#0d0d0d;--muted:#6f6c64;--gold:#a9832f;background:#fff;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.elp06 .grid{display:grid;grid-template-columns:1fr 1.05fr;align-items:stretch;min-height:560px}
.elp06 .imgw{position:relative;overflow:hidden;background:#f4f2ec}
.elp06 .imgw img{width:100%;height:100%;object-fit:cover;display:block}
.elp06 .copy{padding:80px 70px;display:flex;flex-direction:column;justify-content:center;position:relative}
.elp06 .quote-mark{font-family:Georgia,serif;font-size:150px;line-height:1;color:var(--gold);opacity:.18;
  position:absolute;top:10px;left:36px;pointer-events:none}
.elp06 .eyebrow{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:16px}
.elp06 h2{font-family:Georgia,"Times New Roman",serif;font-size:clamp(28px,3.4vw,42px);
  font-weight:400;line-height:1.28;margin:0 0 26px;color:var(--ink);position:relative;z-index:1;max-width:480px}
.elp06 h2 em{font-style:italic;color:var(--gold)}
.elp06 p.sub{color:var(--muted);font-size:14.5px;margin:0 0 30px;max-width:400px;line-height:1.7}
.elp06 .btn{display:inline-flex;align-items:center;gap:10px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;
  font-weight:700;color:var(--ink);text-decoration:none;border-bottom:1px solid var(--ink);padding-bottom:4px;width:fit-content}
.elp06 .btn:hover{color:var(--gold);border-color:var(--gold)}
@media(max-width:860px){.elp06 .grid{grid-template-columns:1fr}.elp06 .copy{padding:56px 30px}.elp06 .imgw{aspect-ratio:4/3}}
</style>
{% assign c = collections['glucksbringer'] %}
<section class="elp06">
  <div class="grid">
    <div class="imgw">
      {% if c and c.products.first %}
        <img src="{{ c.products.first.featured_image | image_url: width: 1000 }}" alt="Glücksbringer Kollektion">
      {% endif %}
    </div>
    <div class="copy">
      <span class="quote-mark">"</span>
      <span class="eyebrow">Signature Kollektion</span>
      <h2>Kleine Symbole, <em>große Bedeutung</em> — für alles, was du still bei dir tragen willst.</h2>
      <p class="sub">Kleeblatt, Evil Eye &amp; Co. treffen auf Gold- und Kristall-Details. Kein lauter Schmuck — sondern ein persönliches Statement.</p>
      {% if c %}<a href="{{ c.url }}" class="btn">Kollektion entdecken →</a>{% endif %}
    </div>
  </div>
</section>
