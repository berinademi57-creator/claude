# → kopieren nach ~/.openjarvis/credentials.toml (macht der Installer)
# Nur für OpenJarvis selbst. Die Keys für Whoop/Garmin/Twilio/Instagram
# stehen in ~/.openjarvis/jarvis-plus.env.

[anthropic]
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY = ""

[openai]
# optional: natürliche deutsche Sprachausgabe + Spracherkennung
OPENAI_API_KEY = ""

[telegram]
# In Telegram @BotFather öffnen → /newbot → Token hier rein
TELEGRAM_BOT_TOKEN = ""

[browser]
# Token aus der Chrome-Erweiterung „Playwright MCP Bridge“ (Erweiterung öffnen → Token kopieren).
# Damit nutzt Jarvis deinen echten Chrome mit allen Logins, ohne jedes Mal zu fragen.
# PLAYWRIGHT_MCP_EXTENSION_TOKEN = ""

[web_search]
# optional, z.B. Tavily oder Brave (siehe OpenJarvis-Doku)
# TAVILY_API_KEY = ""

[get_weather]
# optional: https://openweathermap.org/api
# OPENWEATHERMAP_API_KEY = ""
