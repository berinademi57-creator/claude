# → kopieren nach ~/.openjarvis/jarvis-plus.env (macht der Installer)
# Diese Datei bleibt auf deinem Rechner. NIEMALS in Git hochladen.

JARVIS_USER_NAME=Berin
JARVIS_TIMEZONE=Europe/Berlin

# ─── Whoop (developer.whoop.com → deine App) ───────────────────
WHOOP_CLIENT_ID=999f682c-beaf-4aad-91e4-5371c487d1ce
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8080/callback

# ─── Garmin (dein normales Garmin-Connect-Login) ───────────────
# Nur für den ersten `jarvis-plus garmin-login` nötig, danach löschen.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# ─── Telegram: Jarvis schreibt dir ─────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Twilio: Jarvis ruft dich an / schickt SMS ─────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+49...
MY_PHONE_NUMBER=+49...
TWILIO_VOICE=Polly.Daniel-Neural
TWILIO_LANGUAGE=de-DE

# ─── Instagram (Business-/Creator-Account) ─────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v23.0

# ─── Wächter (jarvis-plus watch) ───────────────────────────────
WATCH_INTERVAL_MINUTES=30
WATCH_QUIET_START=22
WATCH_QUIET_END=7
WATCH_ALERT_COOLDOWN_HOURS=4
# true = bei hohem Stress zusätzlich anrufen (sonst nur Telegram)
WATCH_CALL_ON_HIGH_STRESS=false
