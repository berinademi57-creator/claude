# → kopieren nach ~/.openjarvis/jarvis-plus.env (macht der Installer)
# Diese Datei bleibt auf deinem Rechner. NIEMALS in Git hochladen.

JARVIS_USER_NAME=
JARVIS_TIMEZONE=Europe/Zurich

# ─── Modelle (günstig + schnell, stark nur wenn nötig) ─────────
JARVIS_MODEL_FAST=claude-haiku-5-5
JARVIS_MODEL_SMART=claude-sonnet-5-5

# ─── Whoop (developer.whoop.com → deine App) ───────────────────
WHOOP_CLIENT_ID=999f682c-beaf-4aad-91e4-5371c487d1ce
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8080/callback

# ─── Garmin (dein normales Garmin-Connect-Login) ───────────────
# Nur für den ersten `jarvis-plus garmin-login` nötig, danach löschen.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# ─── Telegram: Jarvis schreibt dir ─────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Twilio: Jarvis ruft dich an / schickt SMS ─────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+41...
MY_PHONE_NUMBER=+41...
TWILIO_VOICE=Polly.Daniel-Neural
TWILIO_LANGUAGE=de-DE

# ─── Telefon-Leitung (mit Jarvis telefonieren) ─────────────────
# Wird von `jarvis-plus telefon-einrichten` automatisch ausgefüllt.
PHONE_SECRET=
PHONE_PUBLIC_URL=
PHONE_PORT=8766
PHONE_LANGUAGE=de-DE
PHONE_GREETING=
# optional, z.B. PHONE_TTS_PROVIDER=ElevenLabs / Google, PHONE_VOICE=…
PHONE_TTS_PROVIDER=
PHONE_VOICE=

# ─── Instagram (Business-/Creator-Account) ─────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v23.0

# ─── Websites veröffentlichen (Netlify, kostenlos) ─────────────
# app.netlify.com → User settings → Applications → Personal access tokens
NETLIFY_AUTH_TOKEN=

# ─── 21st.dev (UI-Komponenten, Key auf 21st.dev/mcp) ───────────
TWENTYFIRST_API_KEY=

# ─── HUD (Oberfläche) ──────────────────────────────────────────
HUD_PORT=8765
# Nur nötig, wenn das HUD direkt im WLAN erreichbar sein soll (HUD_HOST=0.0.0.0).
# Mit Tailscale (empfohlen) bleibt HUD_HOST leer.
HUD_HOST=
HUD_TOKEN=
# HUD beim Anmelden automatisch als App-Fenster öffnen
JARVIS_OPEN_ON_LOGIN=true

# ─── Wächter (jarvis-plus watch) ───────────────────────────────
WATCH_INTERVAL_MINUTES=30
WATCH_QUIET_START=22
WATCH_QUIET_END=7
WATCH_ALERT_COOLDOWN_HOURS=4
# true = bei hohem Stress zusätzlich anrufen (sonst nur Telegram)
WATCH_CALL_ON_HIGH_STRESS=false
