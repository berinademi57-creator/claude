# Kopiere diese Datei nach "trading/.env" und trage deine Werte ein.
# Die .env wird NICHT committet (steht in .gitignore). Niemals Keys in den Chat posten.

# ---------------------------------------------------------------
# 1) KI-Anbieter für TradingAgents (einer reicht)
# ---------------------------------------------------------------
# Anthropic (Claude): Key auf https://console.anthropic.com -> "API Keys".
# Achtung: Das ist NICHT dein Claude.ai-Abo, die API wird extra abgerechnet (Prepaid, ab 5 $).
ANTHROPIC_API_KEY=

# Günstige Modelle als Standard (kleines Budget):
TRADINGAGENTS_LLM_PROVIDER=anthropic
TRADINGAGENTS_QUICK_THINK_LLM=claude-haiku-4-5
TRADINGAGENTS_DEEP_THINK_LLM=claude-sonnet-5
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_OUTPUT_LANGUAGE=German
TRADINGAGENTS_NO_UPDATE_CHECK=1

# Alternative ohne API-Kosten: lokales Modell mit Ollama
#TRADINGAGENTS_LLM_PROVIDER=ollama
#TRADINGAGENTS_QUICK_THINK_LLM=qwen3:8b
#TRADINGAGENTS_DEEP_THINK_LLM=qwen3:8b

# ---------------------------------------------------------------
# 2) Bybit TESTNET (Spielgeld) – https://testnet.bybit.com
#    Account anlegen -> Profil -> API -> "System-generated API Keys",
#    Rechte: "Read-Write" + "Spot Trade". Keine Withdraw-Rechte!
# ---------------------------------------------------------------
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# ---------------------------------------------------------------
# 3) MetaTrader 5 DEMO-Konto (nur Windows)
#    Im MT5-Terminal: Datei -> "Ein Konto eröffnen" -> Demo-Konto.
# ---------------------------------------------------------------
MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
MT5_DEMO_SERVER=
# Optional, falls MT5 nicht im Standardordner installiert ist:
#MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ---------------------------------------------------------------
# 4) Risiko-Grenzen (kleines Budget)
# ---------------------------------------------------------------
# Bybit: maximal so viele USDT pro Kauf
MAX_USDT_PER_TRADE=10
# Bybit: maximal so viel USDT-Wert pro Coin insgesamt
MAX_USDT_PER_SYMBOL=30
# Bybit: Stop-Loss in Prozent unter dem Kaufpreis
STOP_LOSS_PCT=3
# MT5: maximal möglicher Verlust pro Trade in Kontowährung (bis zum Stop-Loss)
MAX_RISK_PER_TRADE=5
# MT5: Stop-Loss / Take-Profit als Vielfaches der ATR(14) auf H1
SL_ATR_MULT=1.5
TP_ATR_MULT=3.0
